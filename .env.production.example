# Production Environment Variables
# IMPORTANT: Never commit actual values to git
# Use a secrets management system instead (AWS Secrets Manager, Azure Key Vault, etc.)

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (Use managed database service for production)
DATABASE_TYPE=postgres
DATABASE_HOST=prod-db.example.com
DATABASE_PORT=5432
DATABASE_NAME=military_system_prod
DATABASE_USER=military_user_prod
DATABASE_PASSWORD=CHANGE_ME_VERY_LONG_PASSWORD_MIN_32_CHARS
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Redis Configuration (Use managed Redis service for production)
REDIS_URL=redis://:CHANGE_ME_PASSWORD@prod-redis.example.com:6379
REDIS_PASSWORD=CHANGE_ME_VERY_LONG_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32
JWT_EXPIRY=7d

# Encryption Configuration
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_EXACTLY_XXXXX
ENCRYPTION_ALGORITHM=aes-256-cbc

# CORS Configuration
CORS_ORIGIN=https://military.example.com
CORS_CREDENTIALS=true

# Frontend Configuration
VITE_API_URL=https://api.military.example.com

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=/var/uploads

# Feature Flags
ENABLE_OFFLINE_SYNC=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ANALYTICS=true

# Monitoring & Observability
SENTRY_DSN=https://your-sentry-project@sentry.io/project-id
MONITORING_ENABLED=true
METRICS_PORT=9090

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@military.example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Military System <noreply@military.example.com>

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_UPLOAD_S3=true
S3_BUCKET=military-system-backups
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
