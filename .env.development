# Development Environment Variables
# This file contains default values for local development
# Copy as .env for Docker Compose or .env.local for direct Node.js usage

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (Docker Compose service names)
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=military_system
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true
DATABASE_SSL=false

# Redis Configuration (Docker Compose service name)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# JWT Configuration (Development only!)
JWT_SECRET=dev-secret-key-change-in-production-immediately-this-is-not-secure
JWT_EXPIRY=7d

# Encryption Configuration (Development only!)
ENCRYPTION_KEY=this-is-not-secure-change-for-prod!
ENCRYPTION_ALGORITHM=aes-256-cbc

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api

# Security (Development defaults - change in production!)
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=simple

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Feature Flags (Enable all for development)
ENABLE_OFFLINE_SYNC=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ANALYTICS=false
ENABLE_DEBUG=true

# Development Features
MOCK_EXTERNAL_SERVICES=false
SEED_DATABASE=false

# Optional: Hot reload
WATCH_MODE=true
